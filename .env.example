# Copy this file to `.env` and fill in what you need.
# Every field in src/config.py:Settings can be overridden this way.

# --- API keys ---
GROQ_API_KEY=
HF_TOKEN=

# --- Common overrides (uncomment to change) ---
# DEFAULT_RETRIEVER=bm25
# DEFAULT_GENERATOR=llama
# DEFAULT_TOP_K=10
# BM25_INDEX_DIR=data/index/bm25
# DENSE_INDEX_DIR=data/index/dense

# --- Hybrid retrieval (retriever="hybrid": fuses bm25 + dense) ---
# HYBRID_ALPHA=0.5          # weight given to dense; (1 - alpha) to bm25
# HYBRID_RRF_K=60           # RRF constant
# HYBRID_USE_RRF=true       # false = min-max normalized weighted sum instead

# --- Reranking (cross-encoder pass after retrieval, before generation) ---
# RERANK_ENABLED=true       # false disables reranking system-wide
# DEFAULT_RERANKER=cross_encoder
# CROSS_ENCODER_MODEL_NAME=BAAI/bge-reranker-base
# CROSS_ENCODER_BATCH_SIZE=32
# RERANK_CANDIDATE_K=50     # how many candidates retrieval fetches before reranking to top_k
